{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/d-b-c-e/dbce-wheel-mod-toolkit/schema/dbce-mod.schema.json",
  "title": "dbce-mod.json",
  "description": "One file per mod: written in the game repo, shipped in the package, installed in the game folder. docs/DBCE-MOD-JSON.md explains every field.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "version", "package"],
  "properties": {
    "schema": { "const": "dbce.mod@1" },
    "id": { "$ref": "#/$defs/slug", "description": "The game id, the same as Wheelkit's catalog and the portfolio grid." },
    "name": { "$ref": "#/$defs/text", "description": "The product name players see, such as \"DiRT 4 Wheel Mod\"." },
    "version": { "$ref": "#/$defs/version" },
    "steamAppId": { "type": "integer", "minimum": 1 },
    "gearboxFromProfile": { "const": true, "description": "Capability: the mod sets the game's own gearbox from [Controls] Transmission in its INI, so Wheelkit's Apply writes that key (ISS-0026). Absent: Apply leaves the gearbox to the player." },
    "folder": { "$ref": "#/$defs/text", "description": "The game's default install folder name." },
    "exe": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$" },
    "log": {
      "type": "object", "additionalProperties": false, "required": ["file", "start"],
      "properties": {
        "file": { "$ref": "#/$defs/text", "description": "Relative to the game folder, or starting with %LOCALAPPDATA%." },
        "start": { "$ref": "#/$defs/text", "description": ".NET regular expression for the mod's first log line; group v is the version." }
      }
    },
    "package": { "$ref": "#/$defs/package" },
    "settings": { "$ref": "#/$defs/settings" },
    "controls": { "$ref": "#/$defs/controls" },
    "cameras": { "type": "array", "items": { "$ref": "#/$defs/cameraStart" } },
    "selfTest": { "$ref": "#/$defs/selfTest" },
    "test": { "$ref": "#/$defs/test" },
    "installed": { "$ref": "#/$defs/installed" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][A-Za-z0-9.+-]+)?$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relPath": { "type": "string", "minLength": 1, "pattern": "^[^\\\\:*?\"<>|]+$", "not": { "pattern": "(^/|(^|/)\\.\\.(/|$))" }, "description": "Relative, forward slashes, never ..." },
    "action": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
    "fromTo": {
      "type": "object", "additionalProperties": false, "required": ["from", "to"],
      "properties": { "from": { "$ref": "#/$defs/relPath" }, "to": { "$ref": "#/$defs/relPath" } }
    },
    "package": {
      "type": "object", "additionalProperties": false, "required": ["kind"],
      "properties": {
        "kind": { "enum": ["dinput8", "bepinex5", "bepinex6-il2cpp", "umm", "ue4ss", "electron-asar", "standalone"] },
        "loader": {
          "type": ["object", "null"], "additionalProperties": false, "required": ["name", "version"],
          "properties": { "name": { "$ref": "#/$defs/text" }, "version": { "$ref": "#/$defs/text" }, "bundle": { "$ref": "#/$defs/relPath" } }
        },
        "payload": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fromTo" } },
        "optional": { "type": "array", "items": { "$ref": "#/$defs/fromTo" } },
        "conflicts": { "type": "array", "items": { "$ref": "#/$defs/relPath" } },
        "seedConfig": { "type": "array", "items": { "$ref": "#/$defs/fromTo" } },
        "knownBuilds": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["file", "sha256"],
            "properties": { "file": { "$ref": "#/$defs/relPath" }, "sha256": { "$ref": "#/$defs/sha256" }, "label": { "$ref": "#/$defs/text" } }
          }
        },
        "strict": { "type": "boolean" },
        "uiHost": { "enum": ["native-panel", "dbce-ui-dll", "dbce-ui-exe", "game"] },
        "oldReceipts": {
          "type": "array",
          "description": "Receipts of the game's installer before the shared one ({file, sha256}), read once for migration",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["receipt"],
            "properties": { "receipt": { "$ref": "#/$defs/relPath" }, "backups": { "$ref": "#/$defs/relPath" } }
          }
        }
      }
    },
    "settings": {
      "type": "object", "additionalProperties": false, "required": ["product", "pages"],
      "properties": {
        "product": { "$ref": "#/$defs/text" },
        "version": { "type": "string" },
        "modPage": { "type": "string" },
        "keys": { "type": "string" },
        "config": { "$ref": "#/$defs/relPath" },
        "format": { "enum": ["ini", "xml"] },
        "stored": { "$ref": "#/$defs/stored" },
        "pages": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "controls": { "$ref": "#/$defs/rows" }, "ffb": { "$ref": "#/$defs/rows" }, "display": { "$ref": "#/$defs/rows" },
            "cameras": { "$ref": "#/$defs/rows" }, "telemetry": { "$ref": "#/$defs/rows" }, "help": { "$ref": "#/$defs/rows" }
          }
        }
      }
    },
    "stored": {
      "description": "The stored settings an editor outside the game (Wheelkit) reads and writes, one item per stored value in file order, with the parsing and dependency rules the mod's own code follows. Moved from Wheelkit's catalog rows (WK-4a); docs/DBCE-MOD-JSON.md.",
      "type": "object", "additionalProperties": false, "required": ["file", "items"],
      "properties": {
        "file": { "$ref": "#/$defs/text", "description": "The main settings file, relative to the game folder." },
        "format": { "enum": ["ini", "toplevel", "xml", "xml-path", "outrun-ini"] },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/storedItem" } }
      }
    },
    "storedRef": {
      "type": "object", "additionalProperties": false, "required": ["key"],
      "properties": { "file": { "$ref": "#/$defs/text" }, "section": { "type": "string" }, "key": { "$ref": "#/$defs/text" } }
    },
    "storedItem": {
      "type": "object", "additionalProperties": false, "required": ["key", "label", "type", "default"],
      "properties": {
        "file": { "$ref": "#/$defs/text", "description": "Another file than the main one; external:<id> names a game-owned file." },
        "fileFormat": { "enum": ["ini", "toplevel", "xml", "xml-path", "json"] },
        "section": { "type": "string" },
        "key": { "$ref": "#/$defs/text" },
        "label": { "$ref": "#/$defs/text" },
        "type": { "enum": ["bool", "choice", "int", "integer", "number"] },
        "options": { "type": "array", "items": { "type": "string" } },
        "default": { "type": "string" },
        "min": { "type": "number" }, "max": { "type": "number" }, "step": { "type": "number", "exclusiveMinimum": 0 },
        "clamp": { "type": "boolean" }, "singlePrecision": { "type": "boolean" }, "strictBoolean": { "type": "boolean" },
        "caseSensitive": { "type": "boolean" },
        "unit": { "type": "string" }, "help": { "type": "string" }, "page": { "type": "string" }, "nextStart": { "type": "boolean" },
        "on": { "type": "string" }, "off": { "type": "string" },
        "hidden": { "type": "boolean" }, "readOnly": { "type": "boolean" }, "seedWhenCreated": { "type": "boolean" },
        "requiresReceiptCapability": { "type": "string" },
        "enabledWhen": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["key", "values"],
            "properties": {
              "file": { "$ref": "#/$defs/text" }, "section": { "type": "string" }, "key": { "$ref": "#/$defs/text" },
              "values": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          }
        },
        "distinctFrom": { "$ref": "#/$defs/storedRef" },
        "distinctExcept": { "type": "array", "items": { "type": "string" } },
        "composite": {
          "type": "object", "additionalProperties": false, "required": ["parts", "writes", "reads"],
          "properties": {
            "parts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/storedRef" } },
            "writes": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": ["string", "null"] } } },
            "reads": {
              "type": "array", "minItems": 1,
              "items": {
                "type": "object", "additionalProperties": false, "required": ["when", "is"],
                "properties": { "when": { "type": "array", "items": { "type": ["string", "null"] } }, "is": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } },
    "row": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,63}$" },
        "kind": { "enum": ["toggle", "choice", "percent", "slider", "number", "binding", "action", "status"] },
        "label": { "type": "string" },
        "help": { "type": "string" },
        "level": { "enum": ["simple", "advanced", "developer"] },
        "apply": { "enum": ["live", "next-start"] },
        "choices": { "type": "array", "minItems": 2, "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "default": { "type": ["boolean", "number", "string"] },
        "unit": { "type": "string" },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 3 },
        "text": { "type": "string" },
        "role": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[A-Za-z0-9]+)+$", "description": "What the value means across games, such as ffb.strength; Wheelkit maps rig profiles by role." },
        "store": {
          "type": "object", "additionalProperties": false, "required": ["key"],
          "properties": {
            "file": { "$ref": "#/$defs/relPath", "description": "Defaults to the settings block's config." },
            "section": { "type": "string" },
            "key": { "$ref": "#/$defs/text" },
            "on": { "type": "string" },
            "off": { "type": "string" },
            "scale": { "type": "number", "exclusiveMinimum": 0, "description": "Stored value = shown value x scale." }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "status" } } }, "else": { "required": ["label"] } },
        { "if": { "properties": { "kind": { "const": "choice" } } }, "then": { "required": ["choices"] }, "else": { "not": { "required": ["choices"] } } },
        { "if": { "properties": { "kind": { "enum": ["slider", "number"] } } }, "then": { "required": ["min", "max"] } },
        { "if": { "properties": { "kind": { "enum": ["status", "action", "binding"] } } }, "then": { "not": { "required": ["default"] } } }
      ]
    },
    "controls": {
      "type": "object", "additionalProperties": false, "required": ["store"],
      "properties": {
        "store": { "$ref": "#/$defs/text", "description": "game = the game's own controls menu; otherwise the shared profile adapter id." },
        "profile": { "$ref": "#/$defs/relPath" },
        "settings": { "$ref": "#/$defs/relPath" },
        "optIn": {
          "type": "object", "additionalProperties": false, "required": ["key", "value"],
          "properties": {
            "section": { "type": "string" }, "key": { "$ref": "#/$defs/text" }, "value": { "type": "string" },
            "default": { "type": "string" }, "appliesAfterRestart": { "type": "boolean" }
          }
        },
        "delivered": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/action" } },
        "unsupported": { "type": "object", "propertyNames": { "$ref": "#/$defs/action" }, "additionalProperties": { "type": "string" } },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["actions"],
            "properties": {
              "actions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/action" } },
              "transmission": { "enum": ["Sequential", "H-pattern"] },
              "settingsKey": { "type": "string" },
              "settingsValues": { "type": "array", "items": { "type": "string" } },
              "settingsDefault": { "type": "string" },
              "note": { "type": "string" }
            }
          }
        },
        "gameControls": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "kind", "label"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]+\\.[A-Za-z0-9.-]+$" }, "kind": { "enum": ["Digital", "Analog"] },
              "label": { "$ref": "#/$defs/text" }, "group": { "type": "string" }
            }
          }
        }
      }
    },
    "cameraStart": {
      "type": "object", "additionalProperties": false, "required": ["camera", "start", "key"],
      "description": "STD-046: the starting choice per camera on triple screens.",
      "properties": {
        "camera": { "enum": ["cockpit", "bonnet", "bumper", "chase", "isometric"] },
        "start": { "enum": ["realistic", "game"] },
        "file": { "$ref": "#/$defs/relPath" },
        "section": { "type": "string" },
        "key": { "$ref": "#/$defs/text" },
        "realistic": { "type": "string" },
        "game": { "type": "string" }
      }
    },
    "selfTest": {
      "type": "object", "additionalProperties": false, "required": ["folder", "steps"],
      "description": "The self-test contract (04-cross-cutting.md D.2): which steps this build runs and which state values it dumps.",
      "properties": {
        "folder": { "$ref": "#/$defs/text" },
        "steps": { "type": "array", "uniqueItems": true, "items": { "enum": ["wait", "f6", "capture", "dump", "start", "camera", "key", "set", "quit"] } },
        "probes": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "type"],
            "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[A-Za-z0-9]+)+$" }, "type": { "enum": ["string", "number", "bool"] }, "label": { "type": "string" } }
          }
        }
      }
    },
    "test": {
      "type": "object", "additionalProperties": false,
      "description": "The testing framework's descriptor for dbce-pilot (07-testing-framework.md): how to launch, protect, reach gameplay, recognize states, route there and quit. Every sub-object below, and the section itself, is optional; the pilot fills in what it knows.",
      "properties": {
        "launch": { "$ref": "#/$defs/launch" },
        "protect": { "type": "array", "items": { "$ref": "#/$defs/text" }, "description": "Save and config paths to back up around a run, game-relative or starting with %LOCALAPPDATA%." },
        "testSave": { "$ref": "#/$defs/testSave", "description": "The prepared test save (from) restored over the player's save (to) for a run, then restored." },
        "states": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/testState" } },
        "entry": { "$ref": "#/$defs/testEntry" },
        "route": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/routeStep" } },
        "quit": { "$ref": "#/$defs/testQuit" }
      }
    },
    "launch": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "steamAppId": { "type": "integer", "minimum": 1 },
        "exe": { "$ref": "#/$defs/text" },
        "args": { "type": "array", "items": { "$ref": "#/$defs/text" } }
      }
    },
    "testSave": {
      "type": "object", "additionalProperties": false, "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/text", "description": "Where the prepared save lives, game-relative or starting with %LOCALAPPDATA%." },
        "to": { "$ref": "#/$defs/text", "description": "Where it is restored to, game-relative or starting with %LOCALAPPDATA%." }
      }
    },
    "testState": {
      "type": "object", "additionalProperties": false, "required": ["state"],
      "properties": {
        "state": { "$ref": "#/$defs/text", "description": "The race state name, such as menu or racing." },
        "field": { "$ref": "#/$defs/text", "description": "The state port field that reports this state, such as race_state." },
        "is": { "type": "string", "description": "The field value that means this state." },
        "text": { "$ref": "#/$defs/text", "description": "Menu text that means this state." },
        "picture": { "$ref": "#/$defs/text", "description": "A picture check that means this state." }
      }
    },
    "testEntry": {
      "type": "object", "additionalProperties": false,
      "description": "The fast path into gameplay: a mailbox command, or the id of a saved route.",
      "properties": {
        "command": { "$ref": "#/$defs/text" },
        "route": { "$ref": "#/$defs/text" }
      }
    },
    "routeStep": {
      "type": "object", "additionalProperties": false,
      "description": "One route step: an optional key or input, then a wait for a state or menu text, with a timeout in milliseconds.",
      "properties": {
        "key": { "$ref": "#/$defs/text" },
        "input": { "$ref": "#/$defs/text" },
        "waitState": { "$ref": "#/$defs/text" },
        "waitText": { "$ref": "#/$defs/text" },
        "timeout": { "type": "integer", "minimum": 1 }
      }
    },
    "testQuit": {
      "type": "object", "additionalProperties": false,
      "description": "How to close the game cleanly: a mailbox command, a key, or an input.",
      "properties": {
        "command": { "$ref": "#/$defs/text" },
        "key": { "$ref": "#/$defs/text" },
        "input": { "$ref": "#/$defs/text" }
      }
    },
    "installed": {
      "type": "object", "additionalProperties": false, "required": ["version", "commit", "installedUtc", "files"],
      "description": "Written only by the installer, in the game folder's copy. Replaces every per-game receipt.",
      "properties": {
        "version": { "$ref": "#/$defs/version" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "installedUtc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$" },
        "loaderInstalledByUs": { "type": "boolean" },
        "files": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
            "properties": { "path": { "$ref": "#/$defs/relPath" }, "sha256": { "$ref": "#/$defs/sha256" } }
          }
        },
        "backups": { "$ref": "#/$defs/relPath" },
        "flags": { "type": "object", "additionalProperties": { "type": "boolean" } }
      }
    }
  }
}
