<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(NefsSource)/VictorBush.Ego.NefsLib/VictorBush.Ego.NefsLib.csproj" />
  </ItemGroup>
  <Target Name="RequireNefsSource" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(NefsSource)' == ''" Text="Set -p:NefsSource to the pinned ego.nefsedit source checkout. See README.md." />
  </Target>
</Project>
