<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DbceInputNet35)' == 'true'">
    <DefineConstants>$(DefineConstants);DBCE_INPUT_NET35</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Dbce.Wheel.Input/ControlBinding.cs" Link="ControlBinding.cs" />
    <Compile Include="../Dbce.Wheel.Input/BindingCapture.cs" Link="BindingCapture.cs" />
    <Compile Include="../Dbce.Wheel.Input/BindingCaptureFlow.cs" Link="BindingCaptureFlow.cs" />
    <Compile Include="../Dbce.Wheel.Input/ControlProfileDocument.cs" Link="ControlProfileDocument.cs" />
    <Compile Include="../Dbce.Wheel.Input/ControlProfileDraft.cs" Link="ControlProfileDraft.cs" />
    <Compile Include="../Dbce.Wheel.Input/DeclaredControlExtras.cs" Link="DeclaredControlExtras.cs" />
    <Compile Include="../Dbce.Wheel.Input/DeclaredExtrasFrame.cs" Link="DeclaredExtrasFrame.cs" />
    <Compile Include="../Dbce.Wheel.Input/BindingEditorContract.cs" Link="BindingEditorContract.cs" />
    <Compile Include="../Dbce.Wheel.Input/BindingEditorPolicy.cs" Link="BindingEditorPolicy.cs" />
    <Compile Include="../Dbce.Wheel.Input/ShimSteering.cs" Link="ShimSteering.cs" />
    <Compile Include="../Dbce.Wheel.Input/ExtraControlValue.cs" Link="ExtraControlValue.cs" />
    <None Include="../../native/controls/controls-vectors.txt" Link="controls-vectors.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
