<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compile check for the Unity sources games compile inside their own plugin, against Unity's managed modules
    (UnityEngine.Modules 2021.3), as a Unity Mono game compiles them: the IMGUI renderers in shared/ui/unity (F6Widgets,
    the session status HUDs, RectBindingPanel and FrameRateReadout) and the racing-row game window in
    shared/display/unity (span window, window landing host, menu centering) with the engine-free display sources it
    needs. Nothing ships from here.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Dbce.Wheel.UnityUi</AssemblyName>
    <RootNamespace>Dbce.Wheel.Ui.Unity</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../shared/ui/unity/*.cs" LinkBase="ui/unity" />
    <Compile Include="../../shared/display/unity/*.cs" LinkBase="display/unity" />
    <Compile Include="../../shared/display/RacingRow.cs;../../shared/display/WindowsMonitors.cs;../../shared/display/WindowLanding.cs;../../shared/display/RacingWindowLanding.cs" LinkBase="display" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dbce.Wheel.Ui\Dbce.Wheel.Ui.csproj" />
    <ProjectReference Include="..\Dbce.Wheel.Telemetry\Dbce.Wheel.Telemetry.csproj" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" PrivateAssets="all" />
  </ItemGroup>

</Project>
