{
  "settings": {
    "product": "GRID (2019) Wheel Mod",
    "version": "0.2.25",
    "modPage": "https://github.com/d-b-c-e/dbce-mods-grid-2019",
    "keys": "F6 settings · F8 force feedback off · F7 camera view",
    "pages": {
      "controls": [
        { "id": "controls.status", "kind": "status", "text": "Set up your wheel in the game's Controls menu." },
        { "id": "controls.menu-dpad", "kind": "toggle", "label": "Wheel D-pad in menus", "default": true, "level": "advanced",
          "help": "Use your wheel's D-pad in the game's menus." }
      ],
      "ffb": [
        { "id": "ffb.status", "kind": "status", "text": "Starts when you drive" },
        { "id": "ffb.enabled", "kind": "toggle", "label": "Force feedback", "default": true, "help": "F8 turns it off at any time." },
        { "id": "ffb.strength", "kind": "percent", "label": "Strength", "default": 50,
          "help": "How heavy the wheel feels. Lower it for strong wheels." },
        { "id": "ffb.restore", "kind": "action", "label": "Restore defaults", "level": "advanced" },
        { "id": "ffb.normalize-gain", "kind": "toggle", "label": "Normalize effect gain", "level": "developer", "apply": "next-start",
          "help": "For wheels that ignore DirectInput effect gain." },
        { "id": "ffb.effects", "kind": "status", "label": "Effects the game uses", "level": "developer", "text": "None yet." }
      ],
      "display": [
        { "id": "display.screens", "kind": "choice", "label": "Screens", "apply": "next-start",
          "choices": ["Off", "Surround", "Separate monitors", "Center screen"], "default": "Center screen",
          "help": "How your three screens are set up in Windows." },
        { "id": "display.eye-distance", "kind": "number", "label": "Eye distance", "unit": "cm", "min": 30, "max": 300,
          "default": 66, "apply": "next-start", "help": "From your eyes to the center screen, level with its edges." },
        { "id": "display.screen-size", "kind": "number", "label": "Screen size", "unit": "in", "min": 10, "max": 100,
          "default": 32, "decimals": 1, "level": "advanced", "apply": "next-start", "help": "Diagonal size of one screen." },
        { "id": "display.side-angle", "kind": "slider", "label": "Side angle", "unit": "°", "min": 0, "max": 89, "default": 70,
          "level": "advanced", "apply": "next-start", "help": "How far the side screens turn toward you." },
        { "id": "display.bezel-gap", "kind": "number", "label": "Bezel gap", "unit": "mm", "min": 0, "max": 100, "default": 8,
          "level": "advanced", "apply": "next-start", "help": "The gap between pictures where two screens meet." },
        { "id": "display.curve", "kind": "choice", "label": "Curved screens", "level": "advanced", "apply": "next-start",
          "choices": ["Flat", "1000R", "1500R", "1800R", "2300R", "3800R"], "default": "1500R",
          "help": "The R number on curved monitors, such as 1500R." },
        { "id": "display.restore", "kind": "action", "label": "Restore defaults", "level": "advanced" },
        { "id": "display.eye-height", "kind": "slider", "label": "Eye height", "unit": " mm", "min": -1000, "max": 1000,
          "default": 0, "level": "developer", "apply": "next-start" },
        { "id": "display.right-angle", "kind": "slider", "label": "Right screen angle", "unit": "°", "min": 0, "max": 89,
          "default": 70, "level": "developer", "apply": "next-start" }
      ],
      "cameras": [
        { "id": "cameras.view", "kind": "status", "text": "Drive to adjust the current camera." },
        { "id": "cameras.hint", "kind": "status", "text": "Numpad + and - zoom, 5 resets." },
        { "id": "cameras.switch", "kind": "action", "label": "Switch view (F7)" },
        { "id": "cameras.reset", "kind": "action", "label": "Reset camera", "level": "advanced",
          "help": "Puts the current camera back to its starting view." },
        { "id": "cameras.fov-offset", "kind": "status", "label": "FOV offset", "level": "developer", "text": "0.0° from the calculated start" }
      ],
      "help": [
        { "id": "help.report", "kind": "action", "label": "Report a problem",
          "help": "Saves a report on your Desktop and opens the mod's page." },
        { "id": "help.restore-all", "kind": "action", "label": "Restore all defaults", "level": "advanced",
          "help": "Every setting returns to its default. Bindings are kept." },
        { "id": "help.log", "kind": "status", "label": "Log", "level": "developer", "text": "dbce-grid2019.log next to the game" }
      ]
    }
  }
}
